@echo off
chcp 65001 >nul
echo ============================================================================
echo 🎨 در حال ساخت خودکار تمام آیکون‌های اندروید، تائوری (دسکتاپ) و وب از روی app-icon...
echo ============================================================================
node setup-assets.cjs
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo ❌ خطا در ساخت آیکون‌ها! لطفاً مطمئن شوید فایل app-icon.png در پوشه اصلی وجود دارد.
    pause
    exit /b %ERRORLEVEL%
)
ie4uinit.exe -show >nul 2>&1
ie4uinit.exe -ClearIconCache >nul 2>&1
echo.
echo ✅ تمام آیکون‌ها با حفظ دقیق وضعیت پس‌زمینه (رنگی یا شفاف) ساخته و کش قبلی تائوری و ویندوز پاک شد.
pause
