{
  "appId": "com.delcom.paymentsystem",
  "productName": "سامانه دلکام",
  "directories": {
    "output": "release-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "app-icon.png"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "app-icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
